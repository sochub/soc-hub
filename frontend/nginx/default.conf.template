server {
    listen 8080;
    server_name localhost;

    root /usr/share/nginx/html;
    index index.html;

    # Serve static files. index.html must never be cached: it names the hashed
    # bundles, and a stale copy would point at bundles a new build removed.
    # Every SPA path (the OAuth consent screen included) is never framed: clickjacking on Approve.
    location / {
        add_header Cache-Control "no-cache" always;
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy "frame-ancestors 'none'" always;
        try_files $uri $uri/ /index.html;
    }

    # Hashed build output: cache forever, and 404 for missing files instead of
    # falling back to index.html (HTML served as JS fails silently -> blank page).
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy "frame-ancestors 'none'" always;
        try_files $uri =404;
    }

    # Evidence uploads only: large, unbuffered bodies with long timeouts. A regex
    # location has no URI part on proxy_pass, so the request URI passes through
    # unchanged. Downloads (/attachments/{id}/download) use the default location.
    location ~ ^/api/v1/cases/[0-9]+/attachments/?$ {
        proxy_pass ${BACKEND_UPSTREAM};
        client_max_body_size ${MAX_UPLOAD_MB}m;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Guest evidence uploads (portal): same size cap and streaming as the analyst block above.
    location ~ ^/api/v1/guest/cases/[0-9]+/attachments/?$ {
        proxy_pass ${BACKEND_UPSTREAM};
        client_max_body_size ${MAX_UPLOAD_MB}m;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Avatar upload: 2 MB image cap in the app; nginx needs headroom for multipart overhead.
    location = /api/v1/users/me/avatar {
        proxy_pass ${BACKEND_UPSTREAM};
        client_max_body_size 3m;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Proxy API requests to the backend service (nginx default 1 MB body limit)
    location /api/v1/ {
        proxy_pass ${BACKEND_UPSTREAM}/api/v1/;
        proxy_set_header Host $host;
        # Overwrite (don't append to) client-supplied forwarding headers: the
        # backend trusts X-Real-IP for login rate limiting.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # OAuth discovery documents (root-relative by spec, so outside /api/v1/).
    location = /.well-known/oauth-authorization-server {
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /.well-known/oauth-protected-resource {
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # MCP server (streamable HTTP): long-lived, unbuffered responses.
    location ^~ /mcp {
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Optional: Proxy /docs or /redoc if needed, or just /api
}
