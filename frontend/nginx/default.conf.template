server {
    listen 8080;
    server_name localhost;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    # Upstream timeouts for every proxied location (nginx's 60s defaults, made explicit); the upload, AI and
    # MCP locations below override the read/send side.
    proxy_connect_timeout 5s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;

    # Serve static files. index.html must never be cached: it names the hashed
    # bundles, and a stale copy would point at bundles a new build removed.
    # Every SPA path (the OAuth consent screen included) is never framed: clickjacking on Approve.
    location / {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/conf.d/security-headers.inc;
        try_files $uri $uri/ /index.html;
    }

    # Hashed build output: cache forever, and 404 for missing files instead of
    # falling back to index.html (HTML served as JS fails silently -> blank page).
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/conf.d/security-headers.inc;
        try_files $uri =404;
    }

    # Proxied locations deliberately carry no SPA headers: the backend owns the headers of its own responses (JSON,
    # OAuth consent/SAML pages), and an SPA CSP (form-action 'self', no inline script) would break those.
    # Evidence uploads only: large, unbuffered bodies with long timeouts. A regex
    # location has no URI part on proxy_pass, so the request URI passes through
    # unchanged. Downloads (/attachments/{id}/download) use the default location.
    location ~ ^/api/v1/cases/[0-9]+/attachments/?$ {
        proxy_pass ${BACKEND_UPSTREAM};
        client_max_body_size ${MAX_UPLOAD_MB}m;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Guest evidence uploads (portal): same size cap and streaming as the analyst block above.
    location ~ ^/api/v1/guest/cases/[0-9]+/attachments/?$ {
        proxy_pass ${BACKEND_UPSTREAM};
        client_max_body_size ${MAX_UPLOAD_MB}m;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Avatar upload: 2 MB image cap in the app; nginx needs headroom for multipart overhead.
    location = /api/v1/users/me/avatar {
        proxy_pass ${BACKEND_UPSTREAM};
        client_max_body_size 3m;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Credential endpoints (password/MFA/SSO login, refresh, guest sign-in): per-client request rate cap
    # (zone in limits.conf). Prefix locations without a URI on proxy_pass forward the request URI unchanged.
    location ^~ /api/v1/auth/ {
        limit_req zone=auth burst=20 nodelay;
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /api/v1/guest/auth/ {
        limit_req zone=auth burst=20 nodelay;
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Alert ingestion webhook (API-key auth): bursty by nature, so a loose cap.
    location = /api/v1/alerts/webhook {
        limit_req zone=webhook burst=200 nodelay;
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # LLM-backed endpoints (copilot, AI settings test, report drafting/export, triage, event suggestions):
    # one request can wait on the model for AI_TIMEOUT_SECONDS (120s default), so allow longer reads.
    location ~ ^/api/v1/(copilot/|ai/|cases/[0-9]+/(triage|report|events/suggest)) {
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_read_timeout 300s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Proxy API requests to the backend service (nginx default 1 MB body limit)
    location /api/v1/ {
        proxy_pass ${BACKEND_UPSTREAM}/api/v1/;
        proxy_set_header Host $host;
        # Overwrite (don't append to) client-supplied forwarding headers: the
        # backend trusts X-Real-IP for login rate limiting.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # OAuth discovery documents (root-relative by spec, so outside /api/v1/).
    location = /.well-known/oauth-authorization-server {
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /.well-known/oauth-protected-resource {
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # MCP server (streamable HTTP): long-lived, unbuffered responses. Exactly /mcp and /mcp/...,
    # never look-alikes such as /mcpfoo (those fall through to the SPA).
    location = /mcp {
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /mcp/ {
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Optional: Proxy /docs or /redoc if needed, or just /api
}
