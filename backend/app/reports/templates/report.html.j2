<!doctype html>
{#- Autoescaped. The two chart SVGs are the ONLY |safe values: app/reports/charts.py escapes its own input. -#}
{%- set c = report.case -%}
{%- set r = report.report -%}
{%- set ms = report.milestones -%}
{%- macro more(section) -%}
  {%- if truncated.get(section) -%}<p class="more">+{{ truncated[section] }} more — see JSON export</p>{%- endif -%}
{%- endmacro -%}
{%- macro timeline_table(rows) -%}
  {%- if rows -%}
  <table>
    <thead><tr><th class="n">#</th><th class="w-dt">Time (UTC)</th><th>Lane</th><th>Event</th><th>Actor</th></tr></thead>
    <tbody>
    {%- for e in rows[:limits.timeline] %}
      <tr><td class="mono n">{{ e.n }}</td><td class="mono">{{ e.at | dt(false) }}</td><td>{{ e.lane }}</td>
          <td class="wrap">{{ e.text }}</td><td class="wrap">{{ e.actor or "—" }}</td></tr>
    {%- endfor %}
    </tbody>
  </table>
  {{ more("timeline") }}
  {%- else -%}<p class="muted">No timeline events.</p>{%- endif -%}
{%- endmacro -%}
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ case_ref }} — {{ c.title }}</title>
<style>
{{ font_css }}
@page {
  size: A4;
  margin: 18mm 14mm 18mm 14mm;
  @top-center { content: "TLP:{{ tlp_label }}"; background: {{ tlp_bg }}; color: {{ tlp_fg }};
                border: 1px solid {{ tlp_border }}; font: 600 8pt 'IBM Plex Sans'; padding: 1mm 4mm;
                height: auto; margin-top: 6mm; }
  @bottom-center { content: "TLP:{{ tlp_label }}"; background: {{ tlp_bg }}; color: {{ tlp_fg }};
                   border: 1px solid {{ tlp_border }}; font: 600 8pt 'IBM Plex Sans'; padding: 1mm 4mm;
                   height: auto; margin-bottom: 6mm; }
  @bottom-right { content: "{{ case_ref }} · page " counter(page) " of " counter(pages);
                  font: 7.5pt 'Roboto Mono'; color: #52525b; }
}
html { font-family: 'IBM Plex Sans', sans-serif; font-size: 9.5pt; color: #18181b; line-height: 1.45; }
h1 { font-size: 20pt; font-weight: 600; margin: 0 0 4mm; overflow-wrap: anywhere; }
h2 { font-size: 13pt; font-weight: 600; margin: 8mm 0 3mm; padding-bottom: 1mm; border-bottom: 1px solid #d4d4d8;
     page-break-after: avoid; }
h3 { font-size: 10.5pt; font-weight: 600; margin: 4mm 0 2mm; page-break-after: avoid; }
.mono, td.mono, .facts dd { font-family: 'Roboto Mono', monospace; font-size: 8pt; }
.prose { white-space: pre-wrap; overflow-wrap: anywhere; }
.muted { color: #71717a; }
.more { color: #52525b; font-style: italic; font-size: 8.5pt; }
.note { border-left: 3px solid #ea580c; background: #fff7ed; padding: 2mm 3mm; margin: 3mm 0; }
.cover { page-break-after: always; padding-top: 30mm; }
.cover .kicker { font-family: 'Roboto Mono', monospace; font-size: 9pt; color: #52525b; letter-spacing: 0.08em; }
.tlp-badge { display: inline-block; padding: 1mm 4mm; font-weight: 600; background: {{ tlp_bg }};
             color: {{ tlp_fg }}; border: 1px solid {{ tlp_border }}; margin: 4mm 0; }
.facts { display: grid; grid-template-columns: 38mm auto; gap: 1mm 4mm; margin: 0; }
.facts dt { color: #52525b; }
.facts dd { margin: 0; overflow-wrap: anywhere; }
table { width: 100%; border-collapse: collapse; margin: 2mm 0; table-layout: fixed; }
th { text-align: left; font-weight: 600; font-size: 8pt; color: #3f3f46; border-bottom: 1px solid #a1a1aa;
     padding: 1mm 1.5mm; }
td { border-bottom: 1px solid #e4e4e7; padding: 1mm 1.5mm; vertical-align: top; font-size: 8.5pt; }
td.wrap, td.mono { overflow-wrap: anywhere; word-break: break-word; }
th.n, td.n { width: 9mm; }
th.w-dt { width: 37mm; }
tr { page-break-inside: avoid; }
.chart svg { width: 100%; height: auto; }
.chart { margin: 3mm 0; }
.mal { color: #b91c1c; font-weight: 600; }
.integrity { font-size: 8pt; color: #52525b; }
</style>
</head>
<body>

<section class="cover">
  <div class="kicker">INCIDENT REPORT · {{ case_ref }}</div>
  <h1>{{ c.title }}</h1>
  <div class="tlp-badge">TLP:{{ tlp_label }}</div>
  <dl class="facts">
    <dt>Severity</dt><dd>{{ c.severity }}</dd>
    <dt>Status</dt><dd>{{ c.status }}</dd>
    <dt>Owner</dt><dd>{{ c.owner or "—" }}</dd>
    <dt>Opened</dt><dd>{{ c.created_at | dt }}</dd>
    <dt>Resolved</dt><dd>{{ c.resolved_at | dt }}</dd>
    <dt>Report type</dt><dd>{{ "Full" if report.meta.full else "Key events" }}</dd>
    <dt>Generated</dt><dd>{{ report.meta.generated_at | dt }}</dd>
    <dt>Generated by</dt><dd>{{ report.meta.generated_by.email if report.meta.generated_by else "—" }}</dd>
    <dt>Narrative updated</dt><dd>{{ r.updated_at | dt }}{% if r.updated_by %} by {{ r.updated_by }}{% endif %}</dd>
  </dl>
</section>

<section>
  <h2>1. Executive summary</h2>
  <div class="prose">{{ report.report.executive_summary or "—" }}</div>
  {%- if ms.out_of_order %}
  <p class="note">Milestone times are out of order — check the overrides.</p>
  {%- endif %}
  <div class="chart">{{ lifecycle_svg | safe }}</div>
  <h3>Key facts</h3>
  <dl class="facts">
    <dt>Time to detect</dt><dd>{{ ms.ttd_seconds | duration }}</dd>
    <dt>Time to contain</dt><dd>{{ ms.ttc_seconds | duration }}</dd>
    <dt>Time to recover</dt><dd>{{ ms.ttr_seconds | duration }}</dd>
    <dt>SLA response</dt><dd>{{ c.sla.response }}</dd>
    <dt>SLA resolution</dt><dd>{{ c.sla.resolution }}</dd>
    <dt>Indicators</dt><dd>{{ report.iocs | length }}</dd>
    <dt>Evidence files</dt><dd>{{ report.evidence | length }}</dd>
    <dt>Tags</dt><dd>{{ c.tags | join(", ") if c.tags else "—" }}</dd>
  </dl>
</section>

<section>
  <h2>2. Impact</h2>
  <div class="prose">{{ r.impact or "—" }}</div>
</section>

<section>
  <h2>3. Key timeline</h2>
  <div class="chart">{{ timeline_svg | safe }}</div>
  {%- if report.meta.full %}
  <p class="muted">The numbered timeline (all events) is in Appendix A.</p>
  {%- else %}
  {{ timeline_table(report.timeline) }}
  {%- endif %}
</section>

<section>
  <h2>4. Indicators of compromise</h2>
  {%- if report.iocs %}
  <p class="muted">Values are defanged.</p>
  <table>
    <thead><tr><th style="width:40%">Value</th><th>Type</th><th>TLP</th><th>Threat</th><th style="width:28%">Verdicts</th></tr></thead>
    <tbody>
    {%- for i in report.iocs[:limits.iocs] %}
      <tr><td class="mono">{{ i.value | defang(i.type) }}</td><td>{{ i.type }}</td><td>{{ i.tlp or "—" }}</td>
          <td>{{ i.threat_level or "—" }}</td>
          <td>{% for v in i.verdicts %}<span class="{{ 'mal' if v.verdict == 'malicious' else '' }}">{{ v.source }}: {{ v.verdict }}{% if v.score is not none %} ({{ v.score }}){% endif %}</span>{% if not loop.last %}<br>{% endif %}{% else %}—{% endfor %}</td></tr>
    {%- endfor %}
    </tbody>
  </table>
  {{ more("iocs") }}
  {%- else %}<p class="muted">No indicators recorded.</p>{%- endif %}
</section>

<section>
  <h2>5. Actions taken</h2>
  {%- for phase, items in report.actions.items() %}
  <h3>{{ phase | replace("_", " ") | capitalize }}</h3>
  <table>
    <thead><tr><th>Task</th><th class="w-dt">Completed (UTC)</th><th>By</th></tr></thead>
    <tbody>
    {%- for t in items %}
      <tr><td class="wrap">{{ t.title }}</td><td class="mono">{{ t.completed_at | dt(false) }}</td><td class="wrap">{{ t.completed_by or "—" }}</td></tr>
    {%- endfor %}
    </tbody>
  </table>
  {%- else %}<p class="muted">No completed tasks.</p>{%- endfor %}
  <h3>Outstanding</h3>
  {%- if report.outstanding %}
  <table>
    <thead><tr><th>Task</th><th>Phase</th></tr></thead>
    <tbody>
    {%- for t in report.outstanding %}
      <tr><td class="wrap">{{ t.title }}</td><td>{{ (t.phase or "—") | replace("_", " ") }}</td></tr>
    {%- endfor %}
    </tbody>
  </table>
  {%- else %}<p class="muted">Nothing outstanding.</p>{%- endif %}
</section>

<section>
  <h2>6. Evidence</h2>
  {%- if report.evidence %}
  <table>
    <thead><tr><th style="width:22%">File</th><th style="width:9%">Size</th><th style="width:30%">SHA-256</th><th style="width:11%">Malicious</th><th>Uploaded (UTC)</th></tr></thead>
    <tbody>
    {%- for e in report.evidence[:limits.evidence] %}
      <tr><td class="wrap">{{ e.filename }}</td><td class="mono">{{ e.size_bytes | filesize }}</td>
          <td class="mono">{{ e.sha256 or "—" }}</td><td class="{{ 'mal' if e.is_malicious else '' }}">{{ "yes" if e.is_malicious else "no" }}</td>
          <td class="wrap"><span class="mono">{{ e.created_at | dt(false) }}</span><br>{{ e.uploaded_by or "—" }}</td></tr>
    {%- endfor %}
    </tbody>
  </table>
  {{ more("evidence") }}
  {%- else %}<p class="muted">No evidence files.</p>{%- endif %}
</section>

<section>
  <h2>7. Lessons learned</h2>
  <div class="prose">{{ r.lessons_learned or "—" }}</div>
</section>

{%- if report.meta.full %}
<section>
  <h2>Appendix A. Full timeline</h2>
  {{ timeline_table(report.timeline) }}
  <h2>Appendix B. Audit trail</h2>
  {%- set audit = report.get("audit") or [] %}
  {%- if audit %}
  <table>
    <thead><tr><th class="w-dt">Time (UTC)</th><th>Actor</th><th>Entity</th><th>Action</th></tr></thead>
    <tbody>
    {%- for a in audit[:limits.audit] %}
      <tr><td class="mono">{{ a.at | dt(false) }}</td><td class="wrap">{{ a.get("actor_email") or a.get("actor") or "—" }}</td>
          <td class="wrap">{{ a.entity }}</td><td class="wrap">{{ a.action }}</td></tr>
    {%- endfor %}
    </tbody>
  </table>
  {{ more("audit") }}
  {%- else %}<p class="muted">No audit entries.</p>{%- endif %}
</section>
{%- endif %}

<section class="integrity">
  <h2>Report integrity</h2>
  <p>Generated by SOC Hub {{ report.meta.app_version }} ({{ report.meta.schema }}) at {{ report.meta.generated_at | dt }}
  from the case record as it stood at that time. Narrative text is reproduced verbatim and never interpreted as markup;
  indicator values are defanged. {% if truncated %}Some tables were shortened for print. {% endif %}The JSON export of
  this report holds the raw values and complete tables and is the authoritative record.</p>
</section>

</body>
</html>
