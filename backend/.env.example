# Ollama Configuration for AI Copilot

# Set the Ollama base URL (default: http://localhost:11434)
# If running Ollama on a different host or port, update this
OLLAMA_BASE_URL=http://localhost:11434

# Set the Ollama model to use
# Available models: llama3, mistral, codellama, etc.
# Run `ollama list` to see installed models
OLLAMA_MODEL=llama3

# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:password@db:5432/sicms

# Security - MUST be at least 32 chars and not a placeholder. The app refuses
# to boot with a weak key when ENVIRONMENT=production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=your-secret-key-here-change-in-production

# Security mode: production | development | test (default production).
# Outside production the SECRET_KEY / DB password / Redis password checks only
# warn. Under docker compose this comes from ENVIRONMENT in the root .env.
ENVIRONMENT=production
# Logging only (no security effect).
DEBUG=false
# Log every SQL statement.
SQL_ECHO=false

# Login throttling (attempts per window). See docs/configuration.md.
# LOGIN_WINDOW_SECONDS=900
# LOGIN_MAX_PER_EMAIL_IP=5
# LOGIN_MAX_PER_EMAIL=30
# LOGIN_MAX_PER_IP=20

# CORS — comma-separated allowed origins. Leave empty when the frontend is
# served same-origin behind nginx (the default). e.g. https://soc.example.com
BACKEND_CORS_ORIGINS=

# Alert ingestion (/alerts/webhook) is authenticated per-webhook: each tenant
# can create one or more named webhooks (Settings > Integrations), each with its
# own X-API-Key. There is no global webhook key to configure here.

# Redis — in production must include a strong (non-default) password. Under docker compose this
# is set from REDIS_PASSWORD in the root .env (see ../.env.example).
REDIS_URL=redis://:devredispass@redis:6379/0

# Jira Integration (optional)
# JIRA_URL=https://your-domain.atlassian.net
# JIRA_USER=your-email@example.com
# JIRA_API_TOKEN=your-api-token
