# docker-compose variables. Copy to `.env` (gitignored) next to docker-compose.yml.
#
# PRODUCTION: set ENVIRONMENT=production and STRONG, UNIQUE values for every
# secret below. In production the backend refuses to boot with a weak
# SECRET_KEY, a Redis password that is missing or a known default
# (devredispass/changeme/redis), or the dev database password `password`.
# Use URL-safe secrets (they are embedded in connection URLs), e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- PostgreSQL ---------------------------------------------------------------
# The defaults match the existing local-dev volume. Postgres only applies these
# when it initialises an EMPTY data volume; to change them on an existing volume
# run ALTER USER inside the db container first.
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=sicms

# --- Redis (Celery broker, login rate limiting) --------------------------------
# Redis runs with --requirepass; backend and worker get
# REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0 automatically.
REDIS_PASSWORD=devredispass

# --- Security mode -------------------------------------------------------------
# production | development | test. Compose defaults to `production` when unset
# (fails closed). `development` downgrades the credential checks above to
# warnings so these dev defaults work locally. Production MUST use `production`.
ENVIRONMENT=development

# --- AI provider ----------------------------------------------------------------
# AI_* settings are NOT passed through docker-compose. Put them in backend/.env,
# which is mounted into the backend and worker. See the commented examples in
# backend/.env.example and docs/configuration.md#ai-provider.
