# Production settings for docker-compose.prod.yml. Copy to `.env` and replace
# every CHANGE_ME. Generate URL-safe secrets with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# The backend refuses to start in production with weak or default secrets.

# Image tag: latest (the newest release), a release like 1.4.0, or sha-<short>
SOCHUB_TAG=latest

POSTGRES_USER=sochub
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=sochub
REDIS_PASSWORD=CHANGE_ME

# JWT signing key, at least 32 characters
SECRET_KEY=CHANGE_ME
# Public URL(s) the UI is served from, comma-separated
BACKEND_CORS_ORIGINS=https://soc.example.com
# Externally visible origin (SSO callbacks, links in emails)
PUBLIC_BASE_URL=https://soc.example.com

HTTP_PORT=80
MAX_UPLOAD_MB=100
# local (Docker volume) or s3 (see docs/configuration.md)
STORAGE_BACKEND=local

# AI is optional. Point at a hosted provider or your own Ollama; see
# docs/configuration.md#ai-provider for every AI_* option.
# AI_PROVIDER=
# AI_MODEL=
# AI_API_KEY=
